{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd nova-orion-admin && npm install",
  "buildCommand": "cd nova-orion-admin && npm run build",
  "outputDirectory": "nova-orion-admin/dist/nova-orion-admin/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
